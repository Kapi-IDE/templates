# Application
NODE_ENV=production
APP_PORT=3000

# PostgreSQL
POSTGRES_USER=myuser
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=mydb
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379

# Application Secrets
JWT_SECRET=changeme_jwt_secret_min_32_characters
API_KEY=changeme_api_key

# Optional: Monitoring
ENABLE_MONITORING=false

# Optional: SSL
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem