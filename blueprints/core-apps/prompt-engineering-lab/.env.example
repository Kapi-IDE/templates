# Prompt Engineering Lab - Environment Configuration
# Version control for prompts with A/B testing and cost tracking

# ============================================================================
# LLM PROVIDER (Choose ONE - Use Universal LLM Client)
# ============================================================================

# RECOMMENDED: Start with FREE Ollama, upgrade when needed
LLM_PROVIDER=ollama

# ============================================================================
# Option 1: Ollama (FREE - RECOMMENDED FOR BEGINNERS)
# ============================================================================
# Install: brew install ollama (macOS)
# Start: ollama serve
# Pull model: ollama pull llama3.2
#
# Cost: FREE (runs on your computer)
# Setup time: 5 minutes
#
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# ============================================================================
# Option 2: OpenAI (MOST RELIABLE)
# ============================================================================
# Get API key: https://platform.openai.com/api-keys
# Cost: $0.15-$30 per 1M tokens
#
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Option 3: Google Gemini (CHEAPEST CLOUD)
# ============================================================================
# Get API key: https://makersuite.google.com/app/apikey
# Cost: $0.075-$7 per 1M tokens (50% cheaper than OpenAI!)
#
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================================
# Option 4: Azure OpenAI (ENTERPRISE)
# ============================================================================
# Azure Portal: https://portal.azure.com
# Cost: Same as OpenAI
#
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_VERSION=2024-02-01

# ============================================================================
# Option 5: Anthropic Claude (BEST REASONING)
# ============================================================================
# AWS Bedrock: https://aws.amazon.com/bedrock
# Cost: $3-$15 per 1M tokens
#
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# CLAUDE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# ============================================================================
# DEFAULT LLM PARAMETERS
# ============================================================================
# These can be overridden per prompt in the UI
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# ============================================================================
# DATABASE (Prompt Version History)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# Local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/prompt_lab

# Production (Vercel Postgres):
# DATABASE_URL=postgresql://user:pass@region.postgres.vercel.com:5432/database

# Production (Supabase):
# DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co:5432/postgres

# ============================================================================
# OPTIONAL: Cost Tracking & Alerts
# ============================================================================
# Enable cost tracking
ENABLE_COST_TRACKING=true

# Alert when total cost exceeds threshold (USD)
COST_ALERT_THRESHOLD=10.00

# Email for cost alerts
# ALERT_EMAIL=admin@company.com

# ============================================================================
# OPTIONAL: A/B Testing
# ============================================================================
# Enable A/B testing features
ENABLE_AB_TESTING=true

# Minimum sample size for statistical significance
AB_TEST_MIN_SAMPLES=30

# ============================================================================
# OPTIONAL: Prompt Sharing
# ============================================================================
# Enable public prompt sharing
ENABLE_PROMPT_SHARING=true

# Base URL for shared prompts
# PUBLIC_URL=https://your-domain.com

# ============================================================================
# OPTIONAL: Rate Limiting
# ============================================================================
# Max API calls per user per hour
RATE_LIMIT_PER_HOUR=100

# Max prompts per user
MAX_PROMPTS_PER_USER=1000

# ============================================================================
# PRICING REFERENCE (Per 1M Tokens)
# ============================================================================
# Ollama (local):        FREE
# Gemini 2.0 Flash:      $0.075 input / $0.30 output (CHEAPEST CLOUD)
# OpenAI gpt-4o-mini:    $0.15 input / $0.60 output (RECOMMENDED)
# OpenAI gpt-4o:         $2.50 input / $10.00 output (BEST QUALITY)
# Azure OpenAI:          Same as OpenAI (ENTERPRISE SLA)
# Claude 3.5 Sonnet:     $3.00 input / $15.00 output (BEST REASONING)
#
# Typical prompt test (100 tokens in, 200 tokens out):
#   Ollama:              FREE
#   Gemini:              $0.000068
#   OpenAI gpt-4o-mini:  $0.000135
#   OpenAI gpt-4o:       $0.002250
#   Claude:              $0.003300
#
# 100 prompt tests (10,000 tokens total):
#   Ollama:              FREE
#   Gemini:              $0.0068
#   OpenAI gpt-4o-mini:  $0.0135
#   OpenAI gpt-4o:       $0.2250
#   Claude:              $0.3300

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. NEVER commit this file to git (already in .gitignore)
# 2. Use different API keys for dev/staging/production
# 3. Rotate API keys every 90 days
# 4. Set COST_ALERT_THRESHOLD to prevent surprise bills
# 5. Monitor usage at provider dashboards:
#    - OpenAI: https://platform.openai.com/usage
#    - Gemini: https://console.cloud.google.com/apis/dashboard
#    - AWS: https://console.aws.amazon.com/cost-management
# 6. Use read-only database connections where possible
# 7. Enable RATE_LIMIT_PER_HOUR in production

# ============================================================================
# DEPLOYMENT
# ============================================================================
#
# Vercel:
#   vercel env add LLM_PROVIDER
#   vercel env add OPENAI_API_KEY
#   vercel env add DATABASE_URL
#   vercel --prod
#
# Railway:
#   railway variables set LLM_PROVIDER=openai
#   railway variables set OPENAI_API_KEY=sk-proj-...
#   railway variables set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   railway up
#
# Docker:
#   docker run -e LLM_PROVIDER=gemini \
#              -e GEMINI_API_KEY=... \
#              -e DATABASE_URL=postgresql://... \
#              -p 3000:3000 prompt-lab
