# SQL Query Builder - Environment Configuration
# Natural language to SQL with query validation and visualization

# ============================================================================
# REQUIRED: OpenAI API Key
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
#
# Steps to setup:
# 1. Sign up at https://platform.openai.com/signup
# 2. Add payment method at https://platform.openai.com/account/billing
#    (Required - no free tier for API access beyond $5 initial credits)
# 3. Create API key at https://platform.openai.com/api-keys
# 4. Copy the key (starts with sk-proj-) and paste below
#
# Format: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=

# ============================================================================
# REQUIRED: OpenAI Model Selection
# ============================================================================
# Recommended models for SQL generation:
#   gpt-4o-mini      - RECOMMENDED ($0.15/$0.60 per 1M tokens) - Fast, accurate
#   gpt-4o           - Best quality ($2.50/$10.00 per 1M tokens) - Most accurate SQL
#   gpt-3.5-turbo    - Budget option ($0.50/$1.50 per 1M tokens) - Good for simple queries
#
# gpt-4o-mini provides the best balance of cost and accuracy for SQL generation
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# REQUIRED: Database Connection
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# Local development example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
#
# Production examples:
#   Vercel Postgres:  postgresql://user:pass@region.postgres.vercel.com:5432/database
#   Supabase:         postgresql://user:pass@db.xxx.supabase.co:5432/postgres
#   Railway:          postgresql://user:pass@containers-us-west-xxx.railway.app:5432/railway
#   Render:           postgresql://user:pass@region.render.com:5432/database
#
DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp

# ============================================================================
# OPTIONAL: Database Type
# ============================================================================
# Supported databases: postgresql, mysql, sqlite
# Default: postgresql
#
# Note: Different databases have different SQL dialects
# The AI will generate appropriate syntax for your database type
DB_TYPE=postgresql

# ============================================================================
# OPTIONAL: Query Safety Settings
# ============================================================================
# Enable query validation before execution
# Recommended: true (prevents destructive queries)
ENABLE_QUERY_VALIDATION=true

# Allow destructive queries (DELETE, DROP, TRUNCATE)
# Recommended: false in production
ALLOW_DESTRUCTIVE_QUERIES=false

# Maximum rows to return in query results
# Prevents accidentally returning millions of rows
MAX_RESULT_ROWS=1000

# Query timeout in milliseconds
# Prevents long-running queries from hanging
QUERY_TIMEOUT_MS=30000

# ============================================================================
# OPTIONAL: AI Configuration
# ============================================================================
# Temperature for SQL generation (0.0 - 1.0)
# Lower = more deterministic, Higher = more creative
# Recommended: 0.0 for SQL (we want exact, not creative)
OPENAI_TEMPERATURE=0.0

# Max tokens for SQL generation
# SQL queries are usually short, 500 is plenty
OPENAI_MAX_TOKENS=500

# ============================================================================
# OPTIONAL: UI Configuration
# ============================================================================
# Enable query history
ENABLE_QUERY_HISTORY=true

# Enable query sharing (generate shareable links)
ENABLE_QUERY_SHARING=true

# Enable schema visualization
ENABLE_SCHEMA_VISUALIZATION=true

# ============================================================================
# OPTIONAL: Security
# ============================================================================
# JWT secret for authentication (if using auth)
# Generate with: openssl rand -base64 32
# JWT_SECRET=

# Allowed IP addresses (comma-separated)
# Leave empty to allow all
# ALLOWED_IPS=

# ============================================================================
# PRICING REFERENCE
# ============================================================================
# OpenAI Pricing (Per 1M tokens):
#   gpt-4o-mini:     Input: $0.15  | Output: $0.60
#   gpt-4o:          Input: $2.50  | Output: $10.00
#   gpt-3.5-turbo:   Input: $0.50  | Output: $1.50
#
# Typical SQL query generation cost:
#   - Schema context: ~500 tokens input
#   - User question: ~50 tokens input
#   - SQL output: ~100 tokens output
#   - Total per query: ~650 tokens = $0.0001 with gpt-4o-mini
#
# Monthly cost estimate (1,000 queries/month):
#   gpt-4o-mini:     ~$0.10/month
#   gpt-4o:          ~$1.65/month
#   gpt-3.5-turbo:   ~$0.25/month
#
# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. NEVER commit this file to git (already in .gitignore)
# 2. Use different API keys for development and production
# 3. Rotate API keys every 90 days
# 4. Set usage limits in OpenAI dashboard to prevent unexpected charges
# 5. Use read-only database connections in production if possible
# 6. Enable QUERY_VALIDATION and disable ALLOW_DESTRUCTIVE_QUERIES
# 7. Set appropriate MAX_RESULT_ROWS to prevent data exfiltration
# 8. Monitor OpenAI usage at https://platform.openai.com/usage
#
# ============================================================================
# PLATFORM-SPECIFIC DEPLOYMENT
# ============================================================================
#
# Vercel:
#   1. Go to Project Settings → Environment Variables
#   2. Add OPENAI_API_KEY and DATABASE_URL
#   3. Set OPENAI_MODEL=gpt-4o-mini
#   4. Deploy: vercel --prod
#
# Railway:
#   1. railway variables set OPENAI_API_KEY=sk-proj-...
#   2. railway variables set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   3. railway up
#
# Render:
#   1. Dashboard → Environment
#   2. Add OPENAI_API_KEY and DATABASE_URL
#   3. Enable "Auto-Deploy"
#
# Docker:
#   docker run -e OPENAI_API_KEY=sk-proj-... \
#              -e DATABASE_URL=postgresql://... \
#              -p 3000:3000 sql-query-builder
