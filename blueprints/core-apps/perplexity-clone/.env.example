# ============================================================================
# Perplexity Clone - Environment Variables
# ============================================================================
# IMPORTANT: Copy this file to .env.local and fill in your values
# Command: cp .env.example .env.local
#
# ⚠️ NEVER commit .env.local to git (it's already in .gitignore)
# ============================================================================

# === REQUIRED: Search API Key (Choose ONE) ===

# Option 1: Brave Search API (RECOMMENDED)
# Get API key from: https://brave.com/search/api/
# Free tier: 2,000 queries/month, Pro: $5/month for 20,000 queries
# BRAVE_SEARCH_API_KEY=

# Option 2: Serper.dev (CHEAPER)
# Get API key from: https://serper.dev/
# Pricing: $50 for 1M queries (much cheaper at scale)
# SERPER_API_KEY=

# Option 3: Google Custom Search
# Get API key from: https://developers.google.com/custom-search
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=

# Option 4: Bing Search API
# Get API key from: https://www.microsoft.com/en-us/bing/apis
# BING_SEARCH_API_KEY=

# Search provider to use (brave, serper, google, bing)
SEARCH_PROVIDER=brave

# === REQUIRED: LLM Provider (Choose ONE) ===

# Option 1: OpenAI (DEFAULT - Most reliable)
# Get API key from: https://platform.openai.com/api-keys
# Pricing: $0.15-$30 per 1M tokens depending on model
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option 2: Azure OpenAI (ENTERPRISE)
# Get credentials from: https://portal.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-01

# Option 3: Google Gemini (GOOGLE)
# Get API key from: https://makersuite.google.com/app/apikey
# Pricing: Free tier available, then $0.075-$7 per 1M tokens
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# Option 4: Anthropic Claude via Bedrock (AWS)
# AWS credentials for Bedrock access
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CLAUDE_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Option 5: Ollama (FREE - LOCAL)
# Install Ollama from: https://ollama.ai
# No API key needed! Runs completely local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# LLM provider to use (openai, azure, gemini, claude, ollama)
LLM_PROVIDER=openai

# === OPTIONAL: Search Configuration ===
# Number of search results to fetch
SEARCH_RESULTS_COUNT=10

# Number of top results to include in AI context
SEARCH_CONTEXT_COUNT=5

# === OPTIONAL: Application URL ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === OPTIONAL: Node Environment ===
NODE_ENV=development

# ============================================================================
# QUICK START CONFIGURATIONS
# ============================================================================

# --- RECOMMENDED FOR BEGINNERS (Completely Free) ---
# 1. Install Ollama: https://ollama.ai
# 2. Run: ollama pull llama3.2
# 3. Use these settings:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest
# BRAVE_SEARCH_API_KEY=your-brave-key (free tier)
# SEARCH_PROVIDER=brave

# --- RECOMMENDED FOR PRODUCTION (Best Quality) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini
# SEARCH_PROVIDER=serper
# SERPER_API_KEY=your-key

# --- RECOMMENDED FOR ENTERPRISE (Azure) ---
# LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=your-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# SEARCH_PROVIDER=brave

# ============================================================================
# PRICING COMPARISON (Per 1M Tokens)
# ============================================================================
# OpenAI gpt-4o-mini:    $0.15 input / $0.60 output
# OpenAI gpt-4o:         $2.50 input / $10.00 output
# Azure OpenAI:          Same as OpenAI
# Gemini 2.0 Flash:      $0.075 input / $0.30 output (CHEAPEST)
# Claude 3.5 Sonnet:     $3.00 input / $15.00 output
# Ollama (local):        FREE (uses your CPU/GPU)

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit .env.local to version control
# 2. Use separate API keys for development and production
# 3. Rotate API keys every 90 days
# 4. Monitor usage regularly
# 5. Set budget limits to prevent unexpected costs
# 6. For Ollama: No API key needed, but ensure localhost access only
