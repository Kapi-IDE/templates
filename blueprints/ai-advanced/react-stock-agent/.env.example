# ReAct Stock Trading Agent - Environment Configuration
# Based on Modern AI Pro ReAct Framework

# ============================================================================
# REQUIRED: LLM Provider (Choose ONE)
# ============================================================================
# This agent uses the ReAct (Reasoning + Acting) pattern
# You can use any LLM provider - FREE options available!

# Option 1: Groq (FAST & FREE - RECOMMENDED)
# Get API key: https://console.groq.com/keys
# FREE: 14,400 requests/day with llama3-70b-8192
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# Option 2: OpenAI (Most Reliable)
# Get API key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Ollama (100% FREE Local)
# Install: brew install ollama
# Start: ollama serve
# Pull model: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Select your LLM provider
LLM_PROVIDER=groq

# ============================================================================
# REQUIRED: Stock Data API
# ============================================================================
# Polygon.io - Stock market data API
# Get API key: https://polygon.io/dashboard/api-keys
#
# Pricing:
#   FREE: 5 API calls/minute (perfect for testing!)
#   Starter: $29/month (unlimited calls)
#   Developer: $99/month (real-time data)
#
# Sign up:
# 1. Go to https://polygon.io/
# 2. Click "Get Free API Key"
# 3. Verify email
# 4. Copy API key from dashboard
#
POLYGON_API_KEY=

# ============================================================================
# OPTIONAL: News Search API
# ============================================================================
# DuckDuckGo Search (NO API KEY NEEDED!)
# The agent uses DuckDuckGo for news search
# Works out of the box - no configuration required!

# Alternative: NewsAPI (if you want more control)
# Get API key: https://newsapi.org/register
# FREE: 100 requests/day
# NEWS_API_KEY=

# ============================================================================
# OPTIONAL: Agent Configuration
# ============================================================================
# Maximum reasoning steps before stopping
MAX_REASONING_STEPS=10

# Enable paper trading (simulated trades)
ENABLE_PAPER_TRADING=true

# Starting capital for paper trading
PAPER_TRADING_CAPITAL=100000

# ============================================================================
# OPTIONAL: Database (For trade history)
# ============================================================================
# PostgreSQL for storing trade history
# DATABASE_URL=postgresql://postgres:password@localhost:5432/react_trader

# ============================================================================
# GROQ API SETUP (RECOMMENDED - FAST & FREE!)
# ============================================================================
# Groq provides the FASTEST LLM inference available
#
# Setup Steps:
# 1. Go to https://console.groq.com/
# 2. Sign in with Google/GitHub
# 3. Go to API Keys: https://console.groq.com/keys
# 4. Click "Create API Key"
# 5. Copy the key (starts with gsk_)
# 6. Paste above in GROQ_API_KEY
#
# Free Tier Limits:
#   - 14,400 requests per day
#   - 120 requests per minute
#   - Perfect for ReAct agents!
#
# Models Available (all FREE):
#   - llama3-70b-8192 (RECOMMENDED - Best reasoning)
#   - llama3-8b-8192 (Faster, good for simple queries)
#   - mixtral-8x7b-32768 (Longest context)
#
# Cost: $0 (completely free!)

# ============================================================================
# POLYGON.IO SETUP
# ============================================================================
# Polygon.io provides stock market data
#
# Setup Steps:
# 1. Go to https://polygon.io/
# 2. Click "Get Free API Key"
# 3. Sign up with email
# 4. Verify email address
# 5. Go to Dashboard: https://polygon.io/dashboard/api-keys
# 6. Copy your API key
# 7. Paste above in POLYGON_API_KEY
#
# Free Tier:
#   - 5 API calls per minute
#   - Previous day's stock prices
#   - Perfect for testing!
#
# Data Available:
#   - Stock prices (AAPL, MSFT, GOOGL, etc.)
#   - Historical data
#   - Market status
#
# Cost: $0 for basic usage

