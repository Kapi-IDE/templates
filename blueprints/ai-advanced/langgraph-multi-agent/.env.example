# Langraph Multi-Agent System Configuration

# ============================================================================
# LLM Provider Configuration (Universal LLM Client)
# ============================================================================

# Choose your LLM provider (groq, openai, anthropic, gemini, ollama)
LLM_PROVIDER=groq

# Optional: Override default model for provider
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: Adjust temperature (0.0-1.0)
# LLM_TEMPERATURE=0.7


# ============================================================================
# LLM API Keys (Provide key for your chosen provider)
# ============================================================================

# Groq (RECOMMENDED - Fast & FREE)
# Get key: https://console.groq.com/keys
# Default model: llama-3.3-70b-versatile
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI (Optional)
# Get key: https://platform.openai.com/api-keys
# Default model: gpt-4o-mini
# OPENAI_API_KEY=sk-proj-your_openai_key_here

# Anthropic Claude (Optional)
# Get key: https://console.anthropic.com/
# Default model: claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google Gemini (Optional)
# Get key: https://ai.google.dev/
# Default model: gemini-2.0-flash-exp
# GOOGLE_API_KEY=your_google_api_key_here

# Ollama (Optional - FREE local)
# No API key needed - runs locally
# Default model: llama3.2:latest
# Make sure Ollama is installed and running: ollama serve


# ============================================================================
# Tool APIs (Some required, some optional)
# ============================================================================

# Tavily Search (REQUIRED for Research Agent)
# Get key: https://tavily.com/
TAVILY_API_KEY=tvly-your_tavily_key_here

# Polygon.io (REQUIRED for Finance Agent)
# Get FREE key: https://polygon.io/
POLYGON_API_KEY=your_polygon_key_here

# NASA API (Optional - has default key)
# Get key: https://api.nasa.gov/
# NASA_API_KEY=your_nasa_key_here


# ============================================================================
# Application Configuration
# ============================================================================

# Gradio server settings
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# Agent settings
DEFAULT_THREAD_ID=default
ENABLE_AGENT_MEMORY=true
