{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "Production-ready URL shortener with Redis caching, analytics, and QR codes",
  "main": "backend/server.js",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=database/schema.prisma",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:studio": "prisma studio --schema=database/schema.prisma",
    "test": "jest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "url-shortener",
    "redis",
    "express",
    "prisma",
    "qr-code",
    "analytics"
  ],
  "author": "KAPI",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.3",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.20.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
