# Three.js Racing Game - Environment Configuration
# NO API KEYS NEEDED - Runs completely client-side!

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# All game features work without any external APIs or services

# Game title
NEXT_PUBLIC_GAME_TITLE=Turbo Racer 3D

# Enable multiplayer (future feature - currently local only)
NEXT_PUBLIC_ENABLE_MULTIPLAYER=false

# ============================================================================
# OPTIONAL: Analytics & Tracking
# ============================================================================
# Google Analytics (Optional - for tracking player engagement)
# Get from: https://analytics.google.com
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# ============================================================================
# OPTIONAL: Leaderboard (Requires Backend)
# ============================================================================
# If you want global leaderboards, set up a backend API
# NEXT_PUBLIC_API_URL=https://your-backend.com/api

# ============================================================================
# GAME SETTINGS (Defaults - Can be changed in-game)
# ============================================================================
# Graphics quality: low, medium, high, ultra
NEXT_PUBLIC_DEFAULT_GRAPHICS=high

# Audio enabled by default
NEXT_PUBLIC_DEFAULT_AUDIO=true

# Physics quality (affects performance)
# Options: low (30 FPS), medium (60 FPS), high (120 FPS)
NEXT_PUBLIC_PHYSICS_QUALITY=medium

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Show FPS counter
NEXT_PUBLIC_SHOW_FPS=true

# Enable debug mode (shows collision boxes, etc.)
NEXT_PUBLIC_DEBUG_MODE=false

# ============================================================================
# NO EXTERNAL DEPENDENCIES
# ============================================================================
# This game is 100% self-contained:
# ✅ Runs entirely in browser
# ✅ No backend required
# ✅ No API keys needed
# ✅ No database required
# ✅ No authentication needed
#
# Just install and play!
#
# Optional enhancements:
# 📊 Google Analytics - Track player behavior
# 🏆 Backend API - Global leaderboards
# 🎮 Multiplayer server - Real-time racing (future)

# ============================================================================
# HOSTING OPTIONS (All FREE)
# ============================================================================
#
# Vercel (Recommended):
#   1. vercel
#   2. Done! (no environment variables needed)
#
# Netlify:
#   1. netlify deploy
#   2. Done!
#
# GitHub Pages:
#   1. npm run build
#   2. Push to gh-pages branch
#   3. Enable GitHub Pages in repo settings
#
# Cloudflare Pages:
#   1. Connect GitHub repo
#   2. Build command: npm run build
#   3. Output directory: out
#
# All hosting options are FREE for static sites!
