# Simple CRM - Environment Configuration
# Contacts, deals, pipeline management, and invoicing

# ============================================================================
# DATABASE (REQUIRED)
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
#
# Local development:
DATABASE_URL=postgresql://postgres:password@localhost:5432/simple_crm

# Vercel Postgres:
# DATABASE_URL=postgresql://user:pass@region.postgres.vercel.com:5432/database

# Supabase:
# DATABASE_URL=postgresql://user:pass@db.xxx.supabase.co:5432/postgres

# Railway:
# DATABASE_URL=postgresql://user:pass@containers-us-west-xxx.railway.app:5432/railway

# ============================================================================
# AUTHENTICATION (REQUIRED)
# ============================================================================
# JWT secret for session management
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session expiry (in seconds)
SESSION_EXPIRY=86400  # 24 hours

# ============================================================================
# STRIPE INTEGRATION (REQUIRED FOR INVOICING)
# ============================================================================
# Get API keys from: https://dashboard.stripe.com/apikeys
#
# Test mode keys (for development):
# - Publishable key starts with: pk_test_
# - Secret key starts with: sk_test_
#
# Live mode keys (for production):
# - Publishable key starts with: pk_live_
# - Secret key starts with: sk_live_
#
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook secret (for payment notifications)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# EMAIL (OPTIONAL - For notifications)
# ============================================================================
# Email provider: sendgrid, resend, smtp
EMAIL_PROVIDER=sendgrid

# SendGrid (Recommended)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.xxx

# Resend (Alternative)
# Get API key from: https://resend.com/api-keys
# RESEND_API_KEY=re_xxx

# SMTP (Generic)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# From email address
FROM_EMAIL=crm@yourdomain.com
FROM_NAME=Your Company CRM

# ============================================================================
# FILE STORAGE (OPTIONAL - For attachments)
# ============================================================================
# Storage provider: local, s3, cloudinary
STORAGE_PROVIDER=local

# Local storage (default)
UPLOAD_DIR=./uploads

# AWS S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_S3_BUCKET=your-crm-bucket

# Cloudinary
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================================================
# OPTIONAL: AI-Powered Features
# ============================================================================
# Enable AI features (email suggestions, lead scoring, etc.)
ENABLE_AI_FEATURES=false

# LLM Provider (if AI features enabled)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# OPTIONAL: App Configuration
# ============================================================================
# Application URL (for email links, webhooks, etc.)
APP_URL=http://localhost:3000

# Company/Organization name
COMPANY_NAME=Your Company

# Default currency
DEFAULT_CURRENCY=USD

# Tax rate (percentage)
DEFAULT_TAX_RATE=10

# ============================================================================
# OPTIONAL: Security & Limits
# ============================================================================
# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Max file upload size (MB)
MAX_FILE_SIZE_MB=10

# Allowed file types
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.xls,.xlsx,.csv,.png,.jpg,.jpeg

# ============================================================================
# STRIPE PRICING REFERENCE
# ============================================================================
# Stripe Fees:
#   Online payments:    2.9% + $0.30 per transaction (US)
#   International:      +1.5% for international cards
#   Currency conversion: +1% for currency conversion
#
# Example Invoice:
#   $100 invoice: You receive $96.80 (Stripe takes $3.20)
#   $1,000 invoice: You receive $970.30 (Stripe takes $29.70)
#   $10,000 invoice: You receive $9,670.30 (Stripe takes $329.70)
#
# Monthly Platform Fee: $0 (pay-as-you-go)
#
# Setup Guide:
# 1. Sign up: https://dashboard.stripe.com/register
# 2. Verify email and business details
# 3. Get test API keys: https://dashboard.stripe.com/test/apikeys
# 4. Add to .env.local (use test keys for development)
# 5. Setup webhook endpoint: https://dashboard.stripe.com/webhooks
#    - Endpoint URL: https://your-domain.com/api/webhooks/stripe
#    - Events: invoice.payment_succeeded, invoice.payment_failed
# 6. Copy webhook secret to STRIPE_WEBHOOK_SECRET
# 7. For production: Switch to live API keys

# ============================================================================
# SENDGRID EMAIL SETUP (OPTIONAL)
# ============================================================================
# SendGrid Pricing:
#   Free:      100 emails/day (forever free)
#   Essentials: $19.95/month (50,000 emails/month)
#   Pro:       $89.95/month (100,000 emails/month)
#
# Setup Guide:
# 1. Sign up: https://signup.sendgrid.com/
# 2. Verify email address
# 3. Create API key: https://app.sendgrid.com/settings/api_keys
#    - Name: "CRM Email Notifications"
#    - Permissions: "Full Access" or "Mail Send"
# 4. Copy API key (starts with SG.)
# 5. Add to .env.local: SENDGRID_API_KEY=SG.xxx
# 6. Verify sender email: https://app.sendgrid.com/settings/sender_auth
#    - Add your FROM_EMAIL address
#    - Verify via email link
# 7. Test: Send a test email from CRM

# ============================================================================
# AWS S3 SETUP (OPTIONAL - FOR FILE ATTACHMENTS)
# ============================================================================
# S3 Pricing:
#   Storage: $0.023 per GB/month (first 50 TB)
#   Requests: $0.005 per 1,000 PUT requests
#   Data transfer: First 1 GB/month free, then $0.09 per GB
#
# Typical CRM usage (100 users, 1GB files/month):
#   Storage: ~$0.023/month
#   Requests: ~$0.01/month
#   Total: ~$0.03/month
#
# Setup Guide:
# 1. AWS Console: https://console.aws.amazon.com/s3
# 2. Create bucket:
#    - Name: your-crm-bucket
#    - Region: us-east-1 (or nearest)
#    - Block all public access: ON
# 3. Create IAM user:
#    - IAM Console: https://console.aws.amazon.com/iam
#    - Users → Add user
#    - Name: crm-uploader
#    - Permissions: AmazonS3FullAccess (or custom policy)
# 4. Create access key:
#    - User → Security credentials → Create access key
#    - Copy AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# 5. Add to .env.local

# ============================================================================
# SECURITY BEST PRACTICES
# ============================================================================
# 1. NEVER commit this file to git (.gitignore already configured)
# 2. Use different JWT_SECRET for dev/staging/production
# 3. Use Stripe test keys in development, live keys in production
# 4. Rotate JWT_SECRET every 90 days
# 5. Use strong passwords for database
# 6. Enable 2FA on Stripe account
# 7. Monitor Stripe webhooks for failed payments
# 8. Set up alerts for unusual activity
# 9. Backup database regularly
# 10. Use environment-specific API keys (never mix dev/prod)

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# Vercel:
#   1. Project Settings → Environment Variables
#   2. Add all REQUIRED variables
#   3. Add OPTIONAL variables as needed
#   4. Redeploy
#
# Railway:
#   1. railway variables set DATABASE_URL=${{Postgres.DATABASE_URL}}
#   2. railway variables set JWT_SECRET=$(openssl rand -base64 32)
#   3. railway variables set STRIPE_SECRET_KEY=sk_live_...
#   4. railway up
#
# Docker:
#   docker run \
#     -e DATABASE_URL=postgresql://... \
#     -e JWT_SECRET=... \
#     -e STRIPE_SECRET_KEY=... \
#     -p 3000:3000 simple-crm

# ============================================================================
# NO API KEYS NEEDED (for basic CRM features)
# ============================================================================
# Core CRM features work without external APIs:
# ✅ Contact management
# ✅ Deal pipeline
# ✅ Task tracking
# ✅ Notes and activities
# ✅ Custom fields
# ✅ Search and filters
#
# Optional APIs enhance functionality:
# 💰 Stripe: Online invoicing and payments
# 📧 SendGrid: Email notifications
# 📁 S3: File attachments
# 🤖 OpenAI: AI-powered lead scoring and email suggestions
