{
  "name": "healthcare-ai-triage-frontend",
  "version": "1.0.0",
  "description": "Healthcare AI Triage System - Production React Frontend",
  "keywords": [
    "healthcare",
    "triage",
    "ai",
    "react",
    "typescript",
    "hipaa",
    "medical"
  ],
  "author": "KAPI Healthcare Solutions",
  "license": "Proprietary",
  "private": true,
  "homepage": "./",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:production": "NODE_ENV=production react-scripts build",
    "test": "react-scripts test --coverage --watchAll=false",
    "test:watch": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --coverageReporters=text --coverageReporters=lcov --watchAll=false",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md}'",
    "analyze": "npm run build && npx bundle-analyzer build/static/js/*.js",
    "security-audit": "npm audit --audit-level moderate",
    "pre-commit": "npm run lint && npm run type-check && npm run test && npm run format:check",
    "docker:build": "docker build -t healthcare-triage-frontend .",
    "docker:run": "docker run -p 3000:3000 healthcare-triage-frontend"
  },
  "dependencies": {
    "@types/node": "^20.9.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^5.2.2",
    
    "react-router-dom": "^6.18.0",
    "@types/react-router-dom": "^5.3.3",
    
    "axios": "^1.6.2",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-query-devtools": "^5.8.7",
    
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.18",
    "@mui/icons-material": "^5.14.18",
    "@mui/lab": "^5.0.0-alpha.154",
    "@mui/x-data-grid": "^6.18.1",
    "@mui/x-date-pickers": "^6.18.1",
    
    "formik": "^2.4.5",
    "yup": "^1.3.3",
    "@hookform/resolvers": "^3.3.2",
    "react-hook-form": "^7.47.0",
    
    "date-fns": "^2.30.0",
    "lodash": "^4.17.21",
    "@types/lodash": "^4.14.201",
    
    "socket.io-client": "^4.7.4",
    
    "recharts": "^2.8.0",
    "react-chartjs-2": "^5.2.0",
    "chart.js": "^4.4.0",
    
    "react-toastify": "^9.1.3",
    "notistack": "^3.0.1",
    
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.7",
    
    "react-speech-recognition": "^3.10.0",
    "react-speech-kit": "^3.0.1",
    
    "qrcode.react": "^3.1.0",
    "react-barcode": "^1.4.6",
    
    "react-beautiful-dnd": "^13.1.1",
    "@types/react-beautiful-dnd": "^13.1.8",
    
    "react-hotkeys-hook": "^4.4.1",
    
    "i18next": "^23.6.0",
    "react-i18next": "^13.5.0",
    "i18next-browser-languagedetector": "^7.2.0",
    
    "framer-motion": "^10.16.4",
    
    "react-helmet-async": "^1.3.0",
    
    "workbox-background-sync": "^7.0.0",
    "workbox-broadcast-update": "^7.0.0",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-google-analytics": "^7.0.0",
    "workbox-navigation-preload": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-range-requests": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "workbox-streams": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-security": "^1.7.1",
    
    "prettier": "^3.0.3",
    "prettier-plugin-organize-imports": "^3.2.4",
    
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    
    "jest-environment-jsdom": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    
    "msw": "^2.0.8",
    "@mswjs/data": "^0.16.1",
    
    "storybook": "^7.5.3",
    "@storybook/react": "^7.5.3",
    "@storybook/addon-essentials": "^7.5.3",
    "@storybook/addon-docs": "^7.5.3",
    "@storybook/addon-a11y": "^7.5.3",
    
    "@playwright/test": "^1.40.0",
    
    "bundlesize": "^0.18.1",
    "webpack-bundle-analyzer": "^4.9.1",
    
    "cross-env": "^7.0.3",
    "serve": "^14.2.1",
    
    "sass": "^1.69.5",
    
    "source-map-explorer": "^2.5.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.tsx",
      "!src/serviceWorker.ts",
      "!src/reportWebVitals.ts",
      "!src/setupTests.ts",
      "!src/stories/**",
      "!src/**/*.stories.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "bundlesize": [
    {
      "path": "./build/static/js/*.js",
      "maxSize": "500kb"
    },
    {
      "path": "./build/static/css/*.css",
      "maxSize": "100kb"
    }
  ],
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test && npm run build"
    }
  },
  "proxy": "http://localhost:5000"
}