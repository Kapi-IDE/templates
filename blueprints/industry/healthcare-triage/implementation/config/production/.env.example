# Healthcare AI Triage System - Production Environment Configuration
# IMPORTANT: Copy this file to .env and update all values for production deployment
# All sensitive values must be changed before going live

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment
FLASK_ENV=production
NODE_ENV=production
APP_VERSION=1.0.0
DEBUG=false

# Security Keys (MUST CHANGE IN PRODUCTION)
SECRET_KEY=your_ultra_secure_secret_key_at_least_32_characters_long
JWT_SECRET_KEY=your_jwt_secret_key_different_from_main_secret
ENCRYPTION_KEY=32_byte_encryption_key_for_hipaa_data_encryption

# Application URLs
APP_URL=https://healthcare-triage.com
API_URL=https://api.healthcare-triage.com
FRONTEND_URL=https://healthcare-triage.com

# CORS Configuration
CORS_ORIGINS=https://healthcare-triage.com,https://api.healthcare-triage.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_triage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_ultra_secure_postgres_password_change_me
DATABASE_URL=postgresql://postgres:your_ultra_secure_postgres_password_change_me@postgres-service:5432/healthcare_triage

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# CACHE AND SESSION STORAGE
# =============================================================================

# Redis Configuration
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_change_me
REDIS_URL=redis://:your_secure_redis_password_change_me@redis-service:6379/0

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.3

# Google AI Configuration
GOOGLE_API_KEY=your_google_ai_api_key_here
GOOGLE_MODEL=gemini-pro
GOOGLE_PROJECT_ID=your_google_project_id

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Vector Database Configuration
CHROMADB_HOST=chromadb-service
CHROMADB_PORT=8000
CHROMADB_URL=http://chromadb-service:8000
CHROMADB_COLLECTION_PREFIX=healthcare_triage_prod

# =============================================================================
# HIPAA AND SECURITY CONFIGURATION
# =============================================================================

# HIPAA Compliance Settings
ENCRYPT_PHI=true
HIPAA_COMPLIANT_LOGGING=true
AUDIT_LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=2555  # 7 years
DATA_RETENTION_YEARS=7

# Security Headers
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"

# Authentication Configuration
JWT_EXPIRATION_HOURS=8
REFRESH_TOKEN_EXPIRATION_DAYS=30
MFA_REQUIRED=true
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true
FAILED_LOGIN_ATTEMPTS_LIMIT=3
ACCOUNT_LOCKOUT_MINUTES=30

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Health Check Configuration
HEALTH_CHECK_TIMEOUT_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=60

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Gunicorn Web Server
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gevent
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=300
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Request Limits
MAX_CONTENT_LENGTH=10485760  # 10MB
REQUEST_TIMEOUT_SECONDS=300
UPLOAD_MAX_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_BURST=20

# Caching
CACHE_DEFAULT_TIMEOUT=300
CACHE_THRESHOLD=500

# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================

# Email Configuration (for notifications)
SMTP_HOST=smtp.healthcare-triage.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=notifications@healthcare-triage.com
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@healthcare-triage.com

# SMS Configuration (for alerts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Healthcare Integration
# HL7 FHIR Server Configuration
FHIR_SERVER_URL=https://fhir.healthcare-triage.com
FHIR_CLIENT_ID=your_fhir_client_id
FHIR_CLIENT_SECRET=your_fhir_client_secret

# EHR Integration
EHR_INTEGRATION_ENABLED=false
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
CERNER_CLIENT_ID=your_cerner_client_id
CERNER_CLIENT_SECRET=your_cerner_client_secret

# =============================================================================
# BACKUP AND DISASTER RECOVERY
# =============================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_32_bytes

# AWS S3 Configuration (for backups)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=healthcare-triage-backups-prod
S3_BACKUP_PREFIX=daily-backups/

# Disaster Recovery
DR_ENABLED=true
DR_RTO_MINUTES=15  # Recovery Time Objective
DR_RPO_MINUTES=5   # Recovery Point Objective

# =============================================================================
# SCALING AND RESOURCE LIMITS
# =============================================================================

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
MIN_REPLICAS=3
MAX_REPLICAS=10
CPU_THRESHOLD_PERCENT=70
MEMORY_THRESHOLD_PERCENT=80

# Resource Limits
MEMORY_LIMIT_MB=2048
CPU_LIMIT_CORES=2
DISK_SPACE_LIMIT_GB=100

# Connection Limits
MAX_CONCURRENT_CONNECTIONS=1000
MAX_REQUESTS_PER_WORKER=1000

# =============================================================================
# COMPLIANCE AND AUDIT
# =============================================================================

# Audit Configuration
AUDIT_ALL_REQUESTS=true
AUDIT_PATIENT_ACCESS=true
AUDIT_ADMIN_ACTIONS=true
AUDIT_LOGIN_ATTEMPTS=true
AUDIT_EXPORT_ENABLED=true

# Compliance Reporting
COMPLIANCE_REPORTS_ENABLED=true
COMPLIANCE_REPORT_SCHEDULE="0 6 1 * *"  # Monthly on 1st at 6 AM
COMPLIANCE_RETENTION_YEARS=7

# Data Privacy
GDPR_COMPLIANT=true
CCPA_COMPLIANT=true
PATIENT_DATA_ANONYMIZATION=true
RIGHT_TO_DELETION_ENABLED=true

# =============================================================================
# DEVELOPMENT AND TESTING (DISABLED IN PRODUCTION)
# =============================================================================

# Debug Settings (MUST BE FALSE IN PRODUCTION)
FLASK_DEBUG=false
SQL_ECHO=false
TESTING=false

# Development Tools (DISABLED IN PRODUCTION)
PROFILING_ENABLED=false
QUERY_DEBUGGING=false
SILK_ENABLED=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
MULTI_LANGUAGE_SUPPORT=true
VOICE_INPUT_ENABLED=true
MOBILE_APP_SUPPORT=true
ADVANCED_ANALYTICS=true
PREDICTIVE_TRIAGE=true
TELEMEDICINE_INTEGRATION=false
BLOCKCHAIN_AUDIT_TRAIL=false

# Beta Features
BETA_AI_MODELS=false
BETA_WORKFLOWS=false
EXPERIMENTAL_FEATURES=false

# =============================================================================
# LEGAL AND COMPLIANCE NOTICES
# =============================================================================

# Legal Information
PRIVACY_POLICY_URL=https://healthcare-triage.com/privacy
TERMS_OF_SERVICE_URL=https://healthcare-triage.com/terms
HIPAA_NOTICE_URL=https://healthcare-triage.com/hipaa
DATA_PROCESSING_AGREEMENT_URL=https://healthcare-triage.com/dpa

# Support Information
SUPPORT_EMAIL=support@healthcare-triage.com
SUPPORT_PHONE=+1-800-123-4567
EMERGENCY_CONTACT=emergency@healthcare-triage.com

# =============================================================================
# IMPORTANT SECURITY REMINDERS
# =============================================================================

# BEFORE GOING TO PRODUCTION:
# 1. Change ALL default passwords and secret keys
# 2. Enable HTTPS/TLS for all communications
# 3. Set up proper firewall rules
# 4. Configure monitoring and alerting
# 5. Test backup and recovery procedures
# 6. Complete security audit and penetration testing
# 7. Ensure all API keys have appropriate permissions
# 8. Set up log monitoring and SIEM integration
# 9. Configure automated security updates
# 10. Review and sign Business Associate Agreements (BAAs)